{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "firestore.rules",
      "**/.*",
      "**/node_modules/**",
      "tools/**",
      "tests/**",
      "README.md",
      "**/*.xlsm"
    ],
    "cleanUrls": true,
    "headers": [
      { "source": "**/*.@(js|css|webp)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }] },
      { "source": "**/*.@(png|jpg|svg)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] },
      { "source": "/", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "**/*.html", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
    ]
  }
}
